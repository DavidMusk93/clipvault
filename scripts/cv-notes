#!/usr/bin/env python3
"""cv-notes — ClipVault 笔记 agent API 的最小 CLI wrapper（P4）。

用法（token 顺序：--token > $CLIPVAULT_AGENT_TOKEN > $CLIPVAULT_HOME/config/agent-token）：

  cv-notes list [--q S] [--tag S] [--since TS] [--limit N]
  cv-notes get <id>
  cv-notes save [--id ID] [--title S] [--agent S] [--op-id S] [--merge=false] [--parent-hash S] --body S
  cv-notes delete <id>
  cv-notes link <note-id> --to-id ID | --to-hash SHA [--kind K] [--unlink]
  cv-notes links <note-id> [--kind K]
  cv-notes backlinks <note-id> [--kind K]
  cv-notes related <note-id> [--limit N]
  cv-notes tags
  cv-notes meta

服务地址顺序：--base > $CLIPVAULT_BASE > http://127.0.0.1:8080
输出：stdin 可读的 JSON（--body-file 从文件读正文，适合长文本）。
"""

import argparse
import json
import os
import sys
import urllib.error
import urllib.request

KINDS = ["related", "mentions", "explains", "follows", "supersedes", "contradicts"]


def load_token(explicit: str) -> str:
    if explicit:
        return explicit.strip()
    env = os.environ.get("CLIPVAULT_AGENT_TOKEN")
    if env and env.strip():
        return env.strip()
    home = os.environ.get("CLIPVAULT_HOME") or os.path.expanduser(
        "~/Library/Application Support/Keepsake"
    )
    path = os.path.join(home, "config", "agent-token")
    try:
        with open(path, "r", encoding="utf-8") as fh:
            t = fh.read().strip()
            if t:
                return t
    except OSError:
        pass
    sys.exit("no agent token: --token / $CLIPVAULT_AGENT_TOKEN / config/agent-token")


def request(base: str, token: str, method: str, path: str, payload=None) -> dict:
    data = None
    headers = {"Authorization": f"Bearer {token}"}
    if payload is not None:
        data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(base.rstrip("/") + path, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = resp.read().decode("utf-8", "replace")
            try:
                return json.loads(body) if body else {}
            except json.JSONDecodeError:
                return {"raw": body}
    except urllib.error.HTTPError as e:
        try:
            out = json.loads(e.read().decode("utf-8", "replace"))
        except Exception:
            out = {"message": e.reason}
        out["_http"] = e.code
        return out


def emit(obj) -> None:
    if "_http" in obj:
        print(json.dumps(obj, ensure_ascii=False, indent=2), file=sys.stderr)
        sys.exit(1 if obj.get("_http", 500) >= 400 else 0)
    print(json.dumps(obj, ensure_ascii=False, indent=2))


def main() -> None:
    ap = argparse.ArgumentParser(prog="cv-notes", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--base", default=os.environ.get("CLIPVAULT_BASE", "http://127.0.0.1:8080"))
    ap.add_argument("--token", default=None)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("list")
    p.add_argument("--q"); p.add_argument("--tag"); p.add_argument("--since", type=float); p.add_argument("--limit", type=int, default=50)

    sub.add_parser("get").add_argument("id")

    p = sub.add_parser("save")
    p.add_argument("--id"); p.add_argument("--title"); p.add_argument("--agent", default="cv-notes")
    p.add_argument("--op-id"); p.add_argument("--parent-hash")
    p.add_argument("--merge", default=None, help="false = strict CAS")
    p.add_argument("--body"); p.add_argument("--body-file", help="read body from file (- = stdin)")

    sub.add_parser("delete").add_argument("id")

    p = sub.add_parser("link")
    p.add_argument("id"); p.add_argument("--to-id"); p.add_argument("--to-hash")
    p.add_argument("--kind", default="related", choices=KINDS)
    p.add_argument("--unlink", action="store_true")

    p = sub.add_parser("links"); p.add_argument("id"); p.add_argument("--kind", choices=KINDS)
    p = sub.add_parser("backlinks"); p.add_argument("id"); p.add_argument("--kind", choices=KINDS)
    p = sub.add_parser("related"); p.add_argument("id"); p.add_argument("--limit", type=int, default=10)
    sub.add_parser("tags")
    sub.add_parser("meta")

    a = ap.parse_args()
    token = load_token(a.token)

    if a.cmd == "list":
        qs = []
        if a.q: qs.append("q=" + urllib.parse.quote(a.q))
        if a.tag: qs.append("tag=" + urllib.parse.quote(a.tag))
        if a.since is not None: qs.append(f"since={a.since}")
        if a.limit: qs.append(f"limit={a.limit}")
        emit(request(a.base, token, "GET", "/api/notes" + ("?" + "&".join(qs) if qs else "")))
    elif a.cmd == "get":
        emit(request(a.base, token, "GET", f"/api/notes/{a.id}"))
    elif a.cmd == "save":
        if a.body_file:
            body = sys.stdin.read() if a.body_file == "-" else open(a.body_file, encoding="utf-8").read()
        elif a.body:
            body = a.body
        else:
            sys.exit("save: --body or --body-file required")
        payload = {"body": body, "agent": a.agent}
        if a.id: payload["id"] = a.id
        if a.title: payload["title"] = a.title
        if a.op_id: payload["opId"] = a.op_id
        if a.parent_hash: payload["parentHash"] = a.parent_hash
        if a.merge is not None: payload["merge"] = a.merge.lower() != "false"
        emit(request(a.base, token, "POST", "/api/notes", payload))
    elif a.cmd == "delete":
        emit(request(a.base, token, "DELETE", f"/api/notes/{a.id}"))
    elif a.cmd == "link":
        payload = {"kind": a.kind, "linked": not a.unlink}
        if a.to_id: payload["toId"] = a.to_id
        if a.to_hash: payload["toHash"] = a.to_hash
        emit(request(a.base, token, "POST", f"/api/notes/{a.id}/links", payload))
    elif a.cmd == "links":
        emit(request(a.base, token, "GET", f"/api/notes/{a.id}/links" + (f"?kind={a.kind}" if a.kind else "")))
    elif a.cmd == "backlinks":
        emit(request(a.base, token, "GET", f"/api/notes/{a.id}/backlinks" + (f"?kind={a.kind}" if a.kind else "")))
    elif a.cmd == "related":
        emit(request(a.base, token, "GET", f"/api/notes/{a.id}/related?limit={a.limit}"))
    elif a.cmd == "tags":
        emit(request(a.base, token, "GET", "/api/notes/tags"))
    elif a.cmd == "meta":
        emit(request(a.base, token, "GET", "/api/notes/_meta"))


if __name__ == "__main__":
    main()
